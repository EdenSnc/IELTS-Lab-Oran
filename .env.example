# Application
NEXT_PUBLIC_SITE_URL=https://www.ieltslab.org
NEXT_PUBLIC_WHATSAPP_NUMBER=213000000000
FOUNDING_COHORT_CAPACITY=8
FOUNDING_COHORT_CLAIMED=0

# PostgreSQL / Prisma (server only)
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres

# Server-only secrets
ENCRYPTION_KEY=64_HEXADECIMAL_CHARACTERS
# JSON key ring used for new answer-key payloads. Keep ENCRYPTION_KEY while
# legacy format-v1 rows remain; rotate by adding a key and changing the active id.
ANSWER_KEY_ENCRYPTION_KEYS={"2026-01":"64_HEXADECIMAL_CHARACTERS"}
ANSWER_KEY_ACTIVE_KEY_ID=2026-01
TALLY_WEBHOOK_SECRET=replace_with_tally_signing_secret
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
PRIVATE_TEST_ASSET_BUCKET=protected-test-assets

# Authenticated assessment delivery
DEVICE_REPLACEMENT_COOLDOWN_HOURS=168
ATTEMPT_LEASE_SECONDS=45

# Chargily Pay V2 (server only)
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=replace_with_chargily_secret_key
PAYMENT_CALLBACK_BASE_URL=https://www.ieltslab.org

# QStash delivery and request verification (server only)
QSTASH_TOKEN=replace_with_qstash_token
QSTASH_CURRENT_SIGNING_KEY=replace_with_current_signing_key
QSTASH_NEXT_SIGNING_KEY=replace_with_next_signing_key
QSTASH_CALLBACK_BASE_URL=https://www.ieltslab.org

# Live Speaking (server secrets stay server-side)
SPEAKING_ENABLED=true
SPEAKING_VIDEO_ENABLED=true
SPEAKING_STORED_VIDEO_ENABLED=false
SPEAKING_AI_ENABLED=true
SPEAKING_DEFAULT_TIMEZONE=Africa/Algiers
SPEAKING_SLOT_MINUTES=20
SPEAKING_CENTRE_NAME="IELTS Lab Oran centre"
SPEAKING_CENTRE_ADDRESS="Oran, Algeria"
SPEAKING_CANCELLATION_HOURS=4
SPEAKING_JOIN_EARLY_MINUTES=10
SPEAKING_RTC_PROVIDER=livekit
SPEAKING_RTC_TOKEN_TTL_SECONDS=900
SPEAKING_RECORDING_POLICY_VERSION=2026-08-01
SPEAKING_AI_POLICY_VERSION=2026-08-01
SPEAKING_TRAINING_POLICY_VERSION=2026-08-01
SPEAKING_RECORDING_RETENTION_DAYS=180
SPEAKING_AI_DISAGREEMENT_THRESHOLD=1
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
PRIVATE_SPEAKING_RECORDING_BUCKET=private-speaking-recordings
SPEAKING_RECORDING_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SPEAKING_RECORDING_S3_REGION=auto
SPEAKING_RECORDING_S3_ACCESS_KEY=replace_with_storage_s3_access_key
SPEAKING_RECORDING_S3_SECRET_KEY=replace_with_storage_s3_secret_key
# Local development only; ignored in production.
SPEAKING_DEV_AUTH_USER_ID=
# Local test/development-only MFA assurance simulation. Never enable in production.
STAFF_MFA_DEV_AAL2=false

# Optional explicit private certification fixture; must identify a non-demo TestVersion.
CERTIFIED_FIXTURE_TEST_VERSION_ID=

# Writing assessment
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_WRITING_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_WRITING_PASSES=2
GEMINI_SPEAKING_MODEL=gemini-3.5-flash-lite
